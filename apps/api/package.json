{
  "name": "@study-agent/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:create": "node --env-file=../../.env dist/apps/api/src/cli.js create-admin",
    "dev": "node --env-file=../../.env -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/apps/api/src/main.js",
    "worker": "node --env-file=../../.env dist/apps/api/src/worker.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run",
    "storage:info": "node -e \"console.log('SQLite/PostgreSQL migrations run on application startup. See doc/product/05-running-and-storage.md. Prisma scaffolding is archived in resources/legacy/prisma.')\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-express": "^11.1.2",
    "@study-agent/config": "0.1.0",
    "@study-agent/contracts": "0.1.0",
    "bcryptjs": "^3.0.2",
    "openai": "7.43.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "uuid": "^11.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "vitest": "^4.1.12"
  }
}
