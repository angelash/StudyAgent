PORT=3000
WEB_PORT=3000
API_PORT=4000
API_HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@localhost:5432/study_agent
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Optional, recommended for natural Mandarin whiteboard narration.
MINIMAX_API_KEY=
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=Chinese (Mandarin)_Warm_Girl
MINIMAX_TTS_SPEED=1.0
MINIMAX_TTS_VOLUME=1.0
MINIMAX_TTS_PITCH=0
MINIMAX_TTS_EMOTION=calm
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_TIMEOUT_MS=120000
CODEX_PDF_TIMEOUT_MS=240000
CODEX_PDF_MODEL=deepseek-v4-flash
XIAOJIU_CHAT_ENABLED=true
XIAOJIU_CHAT_DEFAULT_MODEL=deepseek-v4-flash
XIAOJIU_CHAT_TIMEOUT_MS=90000
STUDY_PDF_STRUCTURE_MODEL=true
JWT_SECRET=study-agent-dev-secret
TEXTBOOK_BASE_PATH=H:\ChinaTextbook
# Empty uses the Web origin; Next forwards /api to the local API_PORT.
# An explicit external API URL can still be supplied for a split deployment.
NEXT_PUBLIC_API_BASE_URL=

# sqlite (default) or postgres; production never uses memory storage
STUDY_STORAGE=sqlite
# STUDY_DATA_DIR=F:\StudyAgentData
# STUDY_ASSET_ROOT=F:\StudyAgentAssets
# Optional external Python processor; receives one JSON config path, writes reviewed preview metadata.
# STUDY_HANDWRITING_PROCESSOR=/absolute/path/to/handwriting_processor.py
# GESP research archive and generated read-only index; separate from the business DB
# STUDY_GESP_ROOT=F:\StudyAgentGesp
# Python 3.10+ with scripts/processing/requirements.txt installed
STUDY_PYTHON=python
# Audio answers need both executables. Missing tools disable audio selection and display a skip message on existing sessions.
STUDY_FFMPEG=ffmpeg
STUDY_FFPROBE=ffprobe
# true runs one embedded consumer; false allows a separate npm run worker --workspace @study-agent/api
STUDY_WORKER_ENABLED=true
# Only the explicit addresses/ranges of your own reverse proxies; empty ignores forwarded client IPs.
# STUDY_TRUST_PROXY=127.0.0.1/32,::1/128
