{
  "name": "study-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:restart:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-dev.ps1",
    "dev:web": "npm run dev --workspace @study-agent/web",
    "dev:api": "npm run build --workspace @study-agent/contracts && npm run build --workspace @study-agent/config && npm run dev --workspace @study-agent/api",
    "daemon:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/operations/start-daemon.ps1",
    "daemon:start:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/operations/start-daemon.ps1 -SkipBuild",
    "daemon:status": "pm2 list",
    "daemon:restart": "pm2 restart study-agent-api study-agent-web study-agent-health --update-env",
    "daemon:logs": "pm2 logs study-agent-api study-agent-web study-agent-health",
    "daemon:stop": "pm2 stop study-agent-api study-agent-web study-agent-health",
    "build": "npm run build --workspace @study-agent/contracts && npm run build --workspace @study-agent/config && npm run build --workspace @study-agent/api && npm run build --workspace @study-agent/web",
    "test": "npm run test --workspace @study-agent/api",
    "test:e2e": "node scripts/qa/run-browser-acceptance.cjs",
    "lint": "npm run lint --workspace @study-agent/api && npm run lint --workspace @study-agent/web",
    "qa:docs": "node scripts/qa/verify-doc-links.cjs"
  },
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "multer": "2.5.0",
    "postcss": "8.5.31",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.18",
    "concurrently": "^9.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
