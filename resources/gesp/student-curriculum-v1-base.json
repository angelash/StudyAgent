  "tasks": [
    {
      "id": "gesp-student-cpp-sum-two",
      "atomId": "gesp-cpp.l1.io",
      "title": "读入两个整数并输出和",
      "prompt": "从标准输入读入两个整数，向标准输出写它们的和。不要输出提示语。",
      "language": "cpp",
      "standard": "C++17",
      "timeLimitSeconds": 2,
      "memoryLimitMiB": 256,
      "reviewStatus": "original_authored_pilot",
      "probes": [
        { "id": "gesp-student-cpp-sum-two-concept", "dimension": "understanding", "prompt": "标准输入与标准输出的正确C++对象是？", "options": ["cin 与 cout", "printf 与 scanf", "ifstream 与 getline"], "answer": "cin 与 cout" },
        { "id": "gesp-student-cpp-sum-two-trace", "dimension": "procedure", "prompt": "读入“2 3”后，计算a+b并输出的结果是什么？", "options": ["5", "23", "6"], "answer": "5" }
      ],
      "tests": [
        { "input": "2 3\n", "expected": "5\n" },
        { "input": "-4 9\n", "expected": "5\n" },
        { "input": "0 0\n", "expected": "0\n" },
        { "input": "1000000000 2000000000\n", "expected": "3000000000\n" },
        { "input": "-10 -15\n", "expected": "-25\n" }
      ]
    },
    {
      "id": "gesp-student-cpp-division",
      "atomId": "gesp-cpp.l1.division",
      "title": "输出整除商与余数",
