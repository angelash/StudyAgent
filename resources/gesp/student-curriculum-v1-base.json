      "language": "cpp",
      "standard": "C++17",
      "timeLimitSeconds": 2,
      "memoryLimitMiB": 256,
      "reviewStatus": "original_authored_pilot",
      "probes": [
        { "id": "gesp-student-cpp-division-concept", "dimension": "understanding", "prompt": "整数运算17/5的商和17%5的余数分别是？", "options": ["3 和 2", "3.4 和 0", "2 和 3"], "answer": "3 和 2" },
        { "id": "gesp-student-cpp-division-trace", "dimension": "procedure", "prompt": "a=3，b=7时，依次输出a/b与a%b的结果是什么？", "options": ["0 3", "3 0", "0.428571 3"], "answer": "0 3" }
      ],
      "tests": [
        { "input": "17 5\n", "expected": "3 2\n" },
        { "input": "20 4\n", "expected": "5 0\n" },
        { "input": "3 7\n", "expected": "0 3\n" },
        { "input": "0 9\n", "expected": "0 0\n" },
        { "input": "99 10\n", "expected": "9 9\n" }
      ]
    },
