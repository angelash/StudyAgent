        { "id": "gesp-student-cpp-compare-trace", "dimension": "procedure", "prompt": "读入“9 2”后，按题目规则输出什么？", "options": ["1", "-1", "0"], "answer": "1" }
      ],
      "tests": [
        { "input": "2 5\n", "expected": "-1\n" },
