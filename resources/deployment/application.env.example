# Root-owned /etc/studyagent/application.env, mode 0640, group studyagent.
# Build Web with NEXT_PUBLIC_API_BASE_URL empty; /api is served by the same HTTPS origin.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=https://study.example.com
STUDY_TRUST_PROXY=127.0.0.1/32,::1/128
STUDY_STORAGE=postgres
DATABASE_URL=postgresql://study_agent:CHANGE_ME@127.0.0.1:5432/study_agent
STUDY_DATA_DIR=/var/lib/studyagent
STUDY_ASSET_ROOT=/srv/studyagent/assets
STUDY_PYTHON=/opt/studyagent/venv/bin/python
STUDY_FFMPEG=/usr/bin/ffmpeg
STUDY_FFPROBE=/usr/bin/ffprobe
STUDY_WORKER_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
