    "id": "core:math:average",
    "subject": "math",
    "grade": 4,
    "term": "both",
    "name": "平均数的总量等分",
    "strand": "数据与可能性",
    "objective": "先合计总量再按数据个数平均",
    "successCriterion": "按题目条件独立完成平均数的总量等分；用另一个结构的新题核查，并在延迟复测时再次验证。",
    "prerequisiteIds": [
      "foundation:math:divisiondigits"
    ],
    "curriculumVersion": "original-core-v2",
    "status": "published",
    "version": 1,
    "teaching": {
      "reviewStatus": "approved",
      "explanation": "平均数由总量平均分成数据个数份得到，移多补少保持总量；各组人数不同时不能直接平均组平均数。",
      "example": {
        "prompt": "三人读14、20、17页，平均每人几页？",
        "steps": [
          "总量14+20+17=51页。",
          "共3人，51÷3=17页。"
        ],
        "conclusion": "平均17页。"
      },
      "commonErrors": [
        {
          "code": "core:math:average:check",
          "observation": "用最大页数作除数，或遗漏一人的数据。",
          "alternativeExplanations": [
            "可能未分清总量与份数。",
            "也可能已经理解关系，但读数、计算或记录出现遗漏，应分开检查。"
          ],
          "verification": "用条形块移多补少，解释总量为何不变。 撤去示范，用新数值独立完成同一操作，记录关键步骤，再用逆运算、实物或图形核对。"
        }
      ],
      "verification": {
        "understanding": "用条形块移多补少，解释总量为何不变。",
        "procedure": "撤去示范，用新数值独立完成同一操作，记录关键步骤，再用逆运算、实物或图形核对。",
        "transfer": "合并两个人数不同的组，先还原总量再求整体平均。",
        "retention": "三天后更换数值与材料，用基础题和新情境各检查一次；不先给提示，分别保留步骤与受助记录。"
      }
    }
  },
