    "teaching": {
      "reviewStatus": "approved",
      "explanation": "乘法先组成一个等组总量，再与其他部分相加减。先乘除的顺序对应关系，不能任意扩大被重复的范围。",
      "example": {
        "prompt": "计算9+4×6。",
        "steps": [
          "先算4×6=24，表示4组6个。",
          "再算9+24=33，9个散件没有被重复。"
        ],
        "conclusion": "结果33。"
      },
