  "componentTargetDefinitions": [
    {
      "id": "atomic:math:divisionregroup",
      "subject": "math",
      "grade": 3,
      "term": "both",
      "name": "把余下的十换成一并合并个位",
      "strand": "数与运算",
      "objective": "在剩余十和原个位已给定时，把全部剩余十换成一并合并原个位，保持未分数量不变",
      "successCriterion": "能分别记录换出的一与合并后的一，包含零余十或零个位；用实物记录和逆向新题核对，并在真实间隔后独立验证。",
      "prerequisiteIds": [
        "foundation:math:placevalue"
      ],
      "parentId": "foundation:math:divisiondigits",
      "curriculumVersion": "original-atomic-math-v1",
      "status": "published",
      "version": 1,
      "teaching": {
        "reviewStatus": "approved",
        "explanation": "先分完高位后，余下的十仍然属于未分的量。每个十换成10个一，再与原个位合并；换单位改变表示，不改变未分总量。本点给定余十，不要求先求高位商。",
        "example": {
          "prompt": "高位分后还余2个十，原个位是6个一。合起来还有多少个一待分？",
          "steps": [
            "只看未分的2个十与原个位6个一，已经分走的十不再计入。",
            "2个十全部拆开，换成20个一。",
            "把同一种单位合并：20个一加6个一是26个一。"
          ],
          "conclusion": "还余26个一待分。2与6不能直接相加，因为原来的计数单位不同。"
        },
        "commonErrors": [
          {
            "code": "regroup_units_added_directly",
            "observation": "把余十的个数与原个位直接相加，或漏记原个位。",
            "alternativeExplanations": [
              "可能未把十换成一，应给定余十单独核查。",
              "也可能上一步余十已经算错，后续只是沿用错的状态。",
              "也可能理解换单位但合并或记录时遗漏，应换材料复核。"
            ],
            "verification": "先给定正确余十，独立记录换出的一与合并后的一，再用成捆散根和逆向新题验证；若上游余十错误，先核查上游，不据连带错误确定本点问题。"
          }
        ],
        "verification": {
          "understanding": "给定余十与原个位，核对数量守恒记录，说明同一种单位才可直接合并。",
          "procedure": "不提供示范，分别记录余十换出的一和合并后的一；加入零余十或零个位。",
          "transfer": "读取尚未分配的成捆散根清单，再由合并数量反推原个位，用两种不同新题族核查。",
          "retention": "三天后更换数量与材料，独立完成基础及迁移新题；当天同题重复不能证明保持。"
        }
      }
    }
  ],
