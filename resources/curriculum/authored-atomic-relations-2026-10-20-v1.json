  "before": {
    "id": "foundation:math:divisiondigits",
    "subject": "math",
    "grade": 3,
    "name": "多位数除以一位数",
    "strand": "数、关系与表示",
    "term": "both",
    "objective": "按位分配，确定没有余数时的商",
    "successCriterion": "在明确条件下独立完成“多位数除以一位数”，能说明所用关系或步骤",
    "prerequisiteIds": [
      "foundation:math:divisiontable",
      "foundation:math:placevalue"
    ],
    "curriculumVersion": "foundation-v1",
    "status": "published",
    "version": 1,
    "teaching": {
      "reviewStatus": "approved",
      "explanation": "多位数除以一位数可按位平均分。高位分后剩下的量要换成低一位的单位，再与低位合并继续分。",
      "example": {
        "prompt": "把84根小棒平均分成3份。",
        "steps": [
          "8捆十根先分，每份2捆，剩2捆。",
          "剩下20根与4根合成24根，每份再分8根；28×3=84。"
        ],
        "conclusion": "84÷3=28。"
      },
      "commonErrors": [
