    "questions": [
      {
        "id": "source-check:source_check_4746ffd3-09d2-4e88-af96-ebdd8ef17892:q:1",
        "prompt": "某公共阅览区连续两个周五晚间满座，周四上午却有许多空位。管理员说：“周五晚间满座证明近期削减座位导致了拥挤。”若要把观察和解释分开，哪项判断最恰当？",
        "options": [
          "“周五晚间满座”是记录到的现象；“座位被削减导致拥挤”则是需要核对的原因解释。",
          "因为满座连续出现两次，“满座”和“座位被削减”都已变成直接事实。",
          "管理员有日常经验，所以其因果解释可以直接替代现场观察记录。",
          "周四上午有空位说明周五拥挤与时间条件无关。"
        ],
        "selectionMode": "single",
        "hint": "",
        "hintCount": 2,
        "targetLessonIds": [
          "check-live-course-d681e062-e374-4f92-b297-042774ffccea:one"
        ],
        "topic": {
          "lessonId": "check-live-course-d681e062-e374-4f92-b297-042774ffccea:one",
          "title": "区分事实与解释"
        }
      },
      {
        "id": "source-check:source_check_4746ffd3-09d2-4e88-af96-ebdd8ef17892:q:2",
        "prompt": "某校阅览空间连续两个周六下午排队，工作日上午却常有空座。甲说座位数减少，乙说考试临近，丙说周末临时活动带来人流。为了比较这些解释，下一步最合理的是哪项？",
        "options": [
          "把两个周六的记录直接相加，排队时段就是造成排队的原因。",
          "只询问等待最久的人，并把其说法作为共同原因。",
          "核对那两个周六的开放座位数、考试安排、临时活动和开放时长，再与需求相近的其他日期比较。",
          "预先宣布以后每个周六都会排队，并用这个结论解释当前记录。"
        ],
        "selectionMode": "single",
        "hint": "",
        "hintCount": 2,
        "targetLessonIds": [
          "check-live-course-d681e062-e374-4f92-b297-042774ffccea:two"
        ],
        "topic": {
          "lessonId": "check-live-course-d681e062-e374-4f92-b297-042774ffccea:two",
          "title": "比较替代解释"
        }
      },
      {
        "id": "source-check:source_check_4746ffd3-09d2-4e88-af96-ebdd8ef17892:q:3",
        "prompt": "某科普活动连续两场满员，另一场却较冷清。主办方目前只有报名人数，没有保存场地限额、宣传活动、预约时段和天气记录。下列哪些判断有依据？",
        "options": [
          "“连续两场满员”是观察；仅凭它就断定活动内容质量高，证据不足。",
          "既然另一场冷清，天气必然比其他条件更常见。",
          "“场地容量不足”是候选解释，需要核对限额以及相近需求下的容量。",
          "两场满员足以代表全年活动需求不变。",
          "比较天气相近但宣传不同的活动，可帮助区分某些替代解释，但不能一次排除全部原因。"
        ],
        "selectionMode": "multiple",
        "hint": "",
        "hintCount": 2,
        "targetLessonIds": [
          "check-live-course-d681e062-e374-4f92-b297-042774ffccea:one",
          "check-live-course-d681e062-e374-4f92-b297-042774ffccea:two"
        ],
        "topic": {
          "lessonId": "check-live-course-d681e062-e374-4f92-b297-042774ffccea:one",
          "title": "区分事实与解释"
        }
      },
      {
        "id": "source-check:source_check_4746ffd3-09d2-4e88-af96-ebdd8ef17892:q:4",
        "prompt": "某社区课程延长到晚间后，报名人数上升，负责人认为是“晚间时段”带来了更多学习者。近期课程还更换了主题并加强了宣传。哪项复核判断最合适？",
        "options": [
          "延长到晚间后人数上升，已经足以排除主题和宣传变化的影响。",
          "人数上升说明晚间时段是唯一原因。",
          "只要部分学习者说喜欢晚上，就不必核对课程和宣传变化。",
          "晚间时段可能是原因之一，但应比较课程内容、宣传力度和其他时段安排相近时的报名变化。",
          "课程已经延长到晚间，所以其他解释都应被视为错误。"
        ],
        "selectionMode": "single",
        "hint": "",
        "hintCount": 2,
        "targetLessonIds": [
          "check-live-course-d681e062-e374-4f92-b297-042774ffccea:two"
        ],
        "topic": {
          "lessonId": "check-live-course-d681e062-e374-4f92-b297-042774ffccea:two",
          "title": "比较替代解释"
        }
      },
      {
        "id": "source-check:source_check_4746ffd3-09d2-4e88-af96-ebdd8ef17892:q:5",
        "prompt": "某图书室只在两天的巡查表里写了“可用座位很少”，没有记录巡查时刻、活动、开放区域或总座位数。下列哪项最适合作为报告结论？",
        "options": [
          "两次巡查都确认了全馆所有区域长期座位不足。",
          "可报告这轮巡查看到可用座位少，但不能给出全馆长期容量判断或唯一原因。",
          "没有记录总座位数，所以连“当时看到可用座位少”也不能写。",
          "既然没写活动，就可以把原因确定为读者人数增加。"
        ],
        "selectionMode": "single",
        "hint": "",
        "hintCount": 2,
        "targetLessonIds": [
          "check-live-course-d681e062-e374-4f92-b297-042774ffccea:one"
        ],
        "topic": {
          "lessonId": "check-live-course-d681e062-e374-4f92-b297-042774ffccea:one",
          "title": "区分事实与解释"
        }
      },
      {
        "id": "source-check:source_check_4746ffd3-09d2-4e88-af96-ebdd8ef17892:q:6",
        "prompt": "一份简报从两个周末下午的排队记录得出“本校全年周末都拥挤，因此座位供给一定不足”。复核时，下列哪些判断合理？",
        "options": [
          "它把特定时段的两次记录扩大成了全年规律，结论范围超出资料。",
          "排队无法被直接观察，所以“出现排队”也不能作为观察记录。",
          "只有两次记录就已经足以证明座位供给是唯一原因。",
          "若要用排队支持扩容，仍应比较座位供给、需求变化、活动与开放时间等替代解释。",
          "在完成这些条件比较前，至多把座位不足作为候选原因，不能称为唯一原因。"
        ],
